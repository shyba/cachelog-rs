predicate postcondition_clone [@inline:trivial] (self: ()) (args: string) (result: string) =
  let self_ = args in [%#sclone] result = self_

meta "rewrite_def" predicate postcondition_clone

function fn_once_clone (self: ()) (args: string) (res: string) : ()

axiom fn_once_clone_spec: forall self: (), args: string, res: string. [%#sops'0] postcondition_once_clone self args res
