type t_ModelConfig = { key_count: UInt64.t; value_count: UInt64.t; max_write: UInt64.t; max_cache: UInt64.t }

type t_ModelConfigDeepModel = { key_count'0: int; value_count'0: int; max_write'0: int; max_cache'0: int }

function deep_model_usize [@inline:trivial] (self: UInt64.t) : int = [%#snum] UInt64.t'int self

