  /\ Seq.length (view_Vec_CleanRecord_Global state.cache_store) = UInt64.t'int cfg.max_cache
  /\ Seq.length (view_Vec_DurableValue_Global state.durable) = UInt64.t'int cfg.key_count
  /\ Seq.length (view_Vec_bool_Global state.created_dirty) = UInt64.t'int cfg.max_write
