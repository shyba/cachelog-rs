    /\ (forall i'0: int. 0 <= i'0 /\ i'0 < Seq.length (view_Vec_DirtyRecord_Global state.write_store)
      -> dirty_record_ok (index_Vec_DirtyRecord_Global state.write_store i'0) cfg
