let rec flusher_drop (self: MutBorrow.t t_ModelState) (config: t_ModelConfig) (id'1: UInt64.t)
  (return (x: t_Result_unit_ModelError)) =
  {[@stop_split] [@expl:flusher_drop requires] ([@stop_split] [@expl:flusher_drop requires #0] [%#smodel] valid_config config)
  /\ ([@stop_split] [@expl:flusher_drop requires #1] [%#smodel'0] shape_ok self.current config)
  /\ ([@stop_split] [@expl:flusher_drop requires #2] [%#smodel'1] UInt64.lt id'1 config.max_write)}
  any
  [ return (result: t_Result_unit_ModelError) ->
  {[@stop_split] [@expl:flusher_drop ensures] [%#smodel'2] shape_ok self.final config}
    (! return {result}) ]

predicate resolve_refmut_ModelState [@inline:trivial] (_1: MutBorrow.t t_ModelState) = _1.final = _1.current

